# Token do bot Telegram, criado com o @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=

# Opcional: WAHA local (API não oficial). Proteja esta chave e mantenha a API local.
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
WAHA_SESSION=default

# Prefira o ID do grupo (termina em @g.us); o nome serve como alternativa.
WHATSAPP_GROUP_ID=
WHATSAPP_GROUP_NAME=

# Opcional: porta do painel local (padrão 8765)
PANEL_PORT=8765
